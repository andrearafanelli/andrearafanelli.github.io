<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="news-scroll">
      <ul class="news-list">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <!-- `kind` in the news file's front matter sets the icon, label and colour -->
          {% case item.kind %}
            {% when 'paper' %}
              {% assign news_icon = 'fa-solid fa-file-lines' %}{% assign news_label = 'Paper' %}
            {% when 'talk' %}
              {% assign news_icon = 'fa-solid fa-microphone-lines' %}{% assign news_label = 'Talk' %}
            {% when 'poster' %}
              {% assign news_icon = 'fa-solid fa-image' %}{% assign news_label = 'Poster' %}
            {% when 'event' %}
              {% assign news_icon = 'fa-solid fa-people-group' %}{% assign news_label = 'Event' %}
            {% when 'career' %}
              {% assign news_icon = 'fa-solid fa-briefcase' %}{% assign news_label = 'Career' %}
            {% when 'phd' %}
              {% assign news_icon = 'fa-solid fa-graduation-cap' %}{% assign news_label = 'PhD' %}
            {% else %}
              {% assign news_icon = 'fa-solid fa-bullhorn' %}{% assign news_label = 'News' %}
          {% endcase %}
          <li class="news-item news-{{ item.kind | default: 'news' }}">
            <span class="news-icon" aria-hidden="true"><i class="{{ news_icon }}"></i></span>
            <div class="news-content">
              <div class="news-meta">
                <span class="news-date">{{ item.date | date: '%b %Y' }}</span><span class="news-kind">{{ news_label }}</span>
              </div>
              <div class="news-body">
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
