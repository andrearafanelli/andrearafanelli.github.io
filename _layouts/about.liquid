---
layout: default
---
<div class="site-layout">
  {% include sidebar.liquid %}

  <div class="site-main">
    <!-- Bio -->
    <section class="about-intro">
      <header class="page-header">
        <h1 class="page-title">{{ page.title }}</h1>
        {% if page.subtitle %}
          <p class="page-subtitle">{{ page.subtitle }}</p>
        {% endif %}
      </header>
      <div class="about-bio">
        {{ content }}
      </div>
    </section>

    <!-- Selected Papers Section -->
    {% if page.selected_papers %}
      {% assign selected_papers = site.bibliography | where: 'selected', 'true' %}
      {% if selected_papers.size > 0 %}
        <section class="home-section publications-section">
          <h2 class="section-title">Selected Publications</h2>
          {% include selected_papers.liquid %}
          <p class="section-more"><a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a></p>
        </section>
      {% endif %}
    {% endif %}

    <!-- Latest Posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2 class="section-title">Latest Posts</h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected Projects -->
    {% if page.selected_projects %}
      {% assign selected_projects = site.projects | where: 'selected', 'true' %}
      {% if selected_projects.size > 0 %}
        <section class="home-section">
          <h2 class="section-title">Selected Projects</h2>
          <ul class="project-list">
            {% for project in selected_projects limit: 4 %}
              <li>
                <h3>{{ project.title }}</h3>
                <p>{{ project.description }}</p>
                {% if project.tags %}
                  <div>
                    {% for tag in project.tags %}
                      <span class="badge">{{ tag }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <h2 class="section-title">Recent News</h2>
        {% include news.liquid limit=page.announcements.limit %}
        {% if site.data.socials.linkedin_username %}
          <p class="section-more">
            <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">More updates on LinkedIn &rarr;</a>
          </p>
        {% endif %}
      </section>
    {% endif %}
  </div>
</div>
